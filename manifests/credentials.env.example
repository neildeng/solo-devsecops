# 複製成 credentials.env 後填入實際值（credentials.env 不進版控）
#   cp credentials.env.example credentials.env
#
# bootstrap.md 以 `set -a; source ...; set +a` 載入，
# 所以 heredoc 裡的變數才展開得開。

SEAWEEDFS_ADMIN_USERNAME=admin
SEAWEEDFS_ADMIN_PASSWORD=replace-me

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-me

# Zulip 的 secret_key 需為長度足夠的隨機字串，可用：
#   openssl rand -hex 32
ZULIP_SECRET_KEY=replace-me
ZULIP_ADMIN_PASSWORD=replace-me
